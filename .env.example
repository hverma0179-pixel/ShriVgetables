PORT=10000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@shrivegetables.in
ADMIN_PASSWORD=ChangeMe123!

# Gemini shopping helper (server-side only; never put this key in Vite/client variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Recommended on Render so orders, stock and notification subscriptions survive deploys
DATABASE_URL=
DATABASE_SSL=true

# Web push notifications: create with npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shrivegetables.in

# Optional automated WhatsApp Business order alerts
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=91XXXXXXXXXX
STORE_PHONE=91XXXXXXXXXX
WHATSAPP_TEMPLATE_NAME=order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v22.0